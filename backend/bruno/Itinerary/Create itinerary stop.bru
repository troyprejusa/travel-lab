meta {
  name: Create itinerary stop
  type: http
  seq: 14
}

post {
  url: {{base_url}}/api/v1/trip/{{trip_id}}/itinerary
  body: formUrlEncoded
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:form-urlencoded {
  title: Temple visit
  start_time: 2026-04-02T10:00:00
  end_time: 2026-04-02T11:00:00
  description: Example stop
}
